# The production stack's settings (`docker-compose.prod.yml`). Copy this file
# to `.env` beside the compose file, on the server, and fill it in there.
# `.env` is ignored by git; this file holds names and no values, and must
# stay that way.
#
# The demo stack (`docker-compose.yml`) reads none of these.

# The site's address, as Caddy reads it. A public name (`causalpulse.example`)
# gets a public certificate, for which the name must already point at this
# machine and ports 80 and 443 must be reachable from outside. The name must
# have an A record and no AAAA record: the proxy is published on IPv4 only,
# because Docker would show it every IPv6 visitor as one address, and the
# limit on failed sign-ins would then lock them all out together. Required.
CP_SITE_ADDRESS=

# The database's password. Generate one with `openssl rand -hex 32`: the
# compose file places it in a URL as it is, so it must be letters and digits
# only. Postgres takes it when its volume is first created; changing it
# afterwards means changing it inside the database too. Required, and the
# services do not start with a password this repository publishes.
POSTGRES_PASSWORD=

# What the dashboard seals its session cookie with: at least 32 characters.
# Generate one with `openssl rand -hex 32`. Changing it signs everyone out.
# Required, and the dashboard does not start with a secret this repository
# publishes.
CP_SESSION_SECRET=

# The rate limits. Each is a whole number greater than zero; left empty, it
# takes the default named beside it.

# Requests answered 401 from one client address in 15 minutes, after which
# that address is refused until the 15 minutes end. Default 10.
CP_LIMIT_SIGNIN_FAILURES=

# Uploads a user may send in a day, whatever becomes of each. Default 20.
CP_LIMIT_UPLOADS_PER_DAY=

# Analyses a user may start in a day. Default 30.
CP_LIMIT_ANALYSES_PER_DAY=

# Analyses a user may have waiting or running at once. Default 3.
CP_LIMIT_ANALYSES_ACTIVE=

# The host ports the proxy listens on. Leave both empty on a server: 80 and
# 443. `make smoke-prod` sets them, to run beside whatever holds those two.
CP_HTTP_PORT=
CP_HTTPS_PORT=
