[importlinter]
root_packages =
    cp_core
    cp_statistics
    cp_simulation
    cp_causal
    cp_evaluation
    cp_cli

[importlinter:contract:layers]
name = Package layering
type = layers
layers =
    cp_cli
    cp_evaluation
    cp_causal
    cp_statistics
    cp_core

[importlinter:contract:estimators-cannot-see-truth]
name = No CausalPulse package may reach ground truth
type = forbidden
source_modules =
    cp_core
    cp_statistics
    cp_causal
forbidden_modules =
    cp_simulation
