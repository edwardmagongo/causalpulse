[importlinter]
root_packages =
    cp_core
    cp_statistics
    cp_simulation
    cp_causal
    cp_evaluation
    cp_figures
    cp_report
    cp_cli
    cp_api
    cp_worker
    cp_tracking
    cp_llm
    cp_llm_eval

[importlinter:contract:layers]
name = Package layering
type = layers
layers =
    cp_cli | cp_worker
    cp_llm_eval
    cp_llm
    cp_report | cp_tracking
    cp_figures
    cp_evaluation
    cp_causal
    cp_statistics
    cp_core

[importlinter:contract:estimators-cannot-see-truth]
name = No CausalPulse package may reach ground truth
type = forbidden
source_modules =
    cp_core
    cp_statistics
    cp_causal
    cp_api
    cp_worker
    cp_llm
forbidden_modules =
    cp_simulation

[importlinter:contract:api-cannot-fit]
name = The API never fits a model or renders a report
type = forbidden
source_modules =
    cp_api
forbidden_modules =
    cp_causal
    cp_statistics
    cp_evaluation
    cp_figures
    cp_report
    cp_llm
    cp_llm_eval
    cp_cli
    cp_worker
    cp_simulation

[importlinter:contract:worker-sees-only-the-db]
name = The worker imports cp_api.db and cp_api.settings and nothing else from cp_api
type = forbidden
source_modules =
    cp_worker
forbidden_modules =
    cp_api.accounts
    cp_api.auth
    cp_api.validation
    cp_api.migrate
    cp_api.admin
    cp_api.app
    cp_api.deps
    cp_api.pagination
    cp_api.models
    cp_api.openapi

[importlinter:contract:tracking-stays-offline]
name = The API and the worker never import the tracking package
type = forbidden
source_modules =
    cp_api
    cp_worker
forbidden_modules =
    cp_tracking

[importlinter:contract:llm-reads-facts-only]
name = Only cp_llm.extract reads the result types
type = forbidden
source_modules =
    cp_llm.facts
    cp_llm.narrative
    cp_llm.vocabulary
    cp_llm.render
    cp_llm.verify
    cp_llm.prompt
    cp_llm.model
    cp_llm.client
    cp_llm.interpret
forbidden_modules =
    cp_report
    cp_causal
    cp_figures
    cp_evaluation
    cp_statistics

[importlinter:contract:evaluation-stays-offline]
name = The API and the worker never import the LLM evaluation harness
type = forbidden
source_modules =
    cp_api
    cp_worker
forbidden_modules =
    cp_llm_eval
