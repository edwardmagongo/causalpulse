[importlinter]
root_packages =
    cp_core
    cp_statistics
    cp_simulation
    cp_causal
    cp_evaluation
    cp_figures
    cp_report
    cp_cli
    cp_api

[importlinter:contract:layers]
name = Package layering
type = layers
layers =
    cp_cli
    cp_report
    cp_figures
    cp_evaluation
    cp_causal
    cp_statistics
    cp_core

[importlinter:contract:estimators-cannot-see-truth]
name = No CausalPulse package may reach ground truth
type = forbidden
source_modules =
    cp_core
    cp_statistics
    cp_causal
    cp_api
forbidden_modules =
    cp_simulation

[importlinter:contract:api-cannot-fit]
name = The API never fits a model or renders a report
type = forbidden
source_modules =
    cp_api
forbidden_modules =
    cp_causal
    cp_statistics
    cp_evaluation
    cp_figures
    cp_report
    cp_cli
    cp_simulation
